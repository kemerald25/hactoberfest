# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment variables
.env
.env*.local
.env.*
.env.example
.env*.example

# Next.js build outputs
/.next/
/out/
/build/
/dist/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.cache/
**/.cache/

# Testing & Coverage
/coverage/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
firebase-debug.log
firestore-debug.log

# Vercel & Genkit
.vercel
.genkit/

# WhatsApp Bridge / Puppeteer Auth & Cache
.wwebjs_auth/
.wwebjs_cache/
**/.wwebjs_auth/
**/.wwebjs_cache/

# OS and Editor files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
.idea/
.vscode/
*.swp
*.swo

# Temporary duplicate/backup copies created by OS
* copy*
* - Copy*
